{
  "breadcrumbs.enabled": false,
  "cSpell.language": "en,pl",
  "cSpell.useGitignore": false,
  "chat.disableAIFeatures": true,
  "editor.acceptSuggestionOnEnter": "on",
  "editor.cursorBlinking": "solid",
  "editor.cursorSurroundingLines": 1024,
  "editor.defaultFormatter": "wdomitrz.simple-lsp-client",
  "editor.fontFamily": "'JetBrains Mono', monospace",
  "editor.fontLigatures": true,
  "editor.formatOnSave": true,
  "editor.glyphMargin": false,
  "editor.inlayHints.enabled": "on",
  "editor.lineNumbers": "off",
  "editor.minimap.enabled": false,
  "editor.occurrencesHighlight": "multiFile",
  "editor.overviewRulerBorder": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.scrollbar.vertical": "hidden",
  "editor.showFoldingControls": "never",
  "editor.suggest.matchOnWordStartOnly": false,
  "editor.tabCompletion": "on",
  "editor.wordWrap": "on",
  "extensions.experimental.affinity": {
    "jimmyzjx.leaderkey": 1,
    "vscodevim.vim": 1
  },
  "extensions.ignoreRecommendations": true,
  "files.autoSave": "onFocusChange",
  "files.insertFinalNewline": true,
  "files.saveConflictResolution": "overwriteFileOnDisk",
  "files.simpleDialog.enable": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "git.enabled": true,
  "git.openRepositoryInParentFolders": "always",
  "interactiveWindow.executeWithShiftEnter": true,
  "jupyter.askForKernelRestart": false,
  "keyboard.dispatch": "keyCode",
  "leaderkey.overrides.user": {
    ", e N": {
      "command": "go-to-next-problem.next",
      "name": "next error in file"
    },
    ", e P": {
      "command": "go-to-next-problem.prev",
      "name": "previous error in file"
    },
    ", e n": {
      "command": "go-to-next-problem.nextInFiles",
      "name": "next error"
    },
    ", e p": {
      "command": "go-to-next-problem.prevInFiles",
      "name": "previous error"
    }
  },
  "notebook.experimental.remoteSave": true,
  "notebook.formatOnCellExecution": true,
  "notebook.formatOnSave.enabled": true,
  "oneSettings.keybindings": [
    {
      "command": "workbench.action.terminal.toggleTerminal",
      "key": "ctrl+space",
      "when": "terminal.active"
    },
    { "command": "workbench.action.terminal.new", "key": "ctrl+shift+space" },
    {
      "command": "workbench.action.terminal.split",
      "key": "ctrl+\\",
      "when": "terminalFocus"
    },
    { "comment": "Vim keybindings forwarding" },
    {
      "args": { "after": ["<C-u>"] },
      "command": "vim.remap",
      "key": "ctrl+u",
      "when": "editorTextFocus && vim.active && !inDebugRepl"
    },
    {
      "args": { "after": ["<C-k>"] },
      "command": "vim.remap",
      "key": "ctrl+k",
      "when": "editorTextFocus && vim.active && !inDebugRepl"
    },
    {
      "args": { "after": ["<C-d>"] },
      "command": "vim.remap",
      "key": "ctrl+d",
      "when": "editorTextFocus && vim.active && !inDebugRepl"
    },
    {
      "args": { "after": ["<C-S-k>"] },
      "command": "vim.remap",
      "key": "ctrl+shift+k",
      "when": "editorTextFocus && vim.active && !inDebugRepl"
    },
    {
      "args": { "after": ["<C-S-j>"] },
      "command": "vim.remap",
      "key": "ctrl+shift+j",
      "when": "editorTextFocus && vim.active && !inDebugRepl"
    },
    { "comment": "Easy navigation in quick open/QuickPick" },
    {
      "command": "workbench.action.quickOpenSelectNext",
      "key": "ctrl+j",
      "when": "inQuickOpen"
    },
    {
      "command": "workbench.action.quickOpenSelectPrevious",
      "key": "ctrl+k",
      "when": "inQuickOpen"
    },
    { "comment": "Easy navigation in suggestion/intellisense" },
    {
      "command": "selectNextSuggestion",
      "key": "ctrl+j",
      "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus"
    },
    {
      "command": "selectPrevSuggestion",
      "key": "ctrl+k",
      "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus"
    },
    {
      "comment": "Easy navigation in parameter hint (i.e. traverse the hints when there's multiple overload for one method)"
    },
    {
      "command": "showNextParameterHint",
      "key": "ctrl+j",
      "when": "editorFocus && parameterHintsMultipleSignatures && parameterHintsVisible"
    },
    {
      "command": "showPrevParameterHint",
      "key": "ctrl+k",
      "when": "editorFocus && parameterHintsMultipleSignatures && parameterHintsVisible"
    },
    { "comment": "Easy navigation in code action" },
    {
      "command": "selectNextCodeAction",
      "key": "ctrl+j",
      "when": "codeActionMenuVisible"
    },
    {
      "command": "selectPrevCodeAction",
      "key": "ctrl+k",
      "when": "codeActionMenuVisible"
    }
  ],
  "path-autocomplete.triggerOutsideStrings": true,
  "remote.SSH.defaultExtensions": [
    "ionutvmi.path-autocomplete",
    "jacobdufault.fuzzy-search",
    "jimmyzjx.go-to-next-problem",
    "jimmyzjx.leaderkey",
    "jimmyzjx.remote-commons",
    "jimmyzjx.ripgrep",
    "ms-toolsai.jupyter",
    "ms-toolsai.jupyter-renderers",
    "ms-vscode-remote.remote-ssh",
    "ms-vscode-remote.remote-ssh-edit",
    "ms-vscode.hexeditor",
    "ms-vscode.makefile-tools",
    "streetsidesoftware.code-spell-checker",
    "streetsidesoftware.code-spell-checker-polish",
    "vscodevim.vim",
    "wdomitrz.one-settings",
    "wdomitrz.simple-lsp-client"
  ],
  "security.workspace.trust.banner": "always",
  "simpleLspClient.formatters": {
    "format.sh": {
      "cmd": ["format.sh", "stdin", "--filetype", "${filetype}"],
      "filetypes": [
        "c",
        "cpp",
        "cuda-cpp",
        "json",
        "jsonc",
        "lua",
        "python",
        "shellscript",
        "viml"
      ]
    },
    "format_txt": {
      "cmd": ["format.sh", "stdin", "--filename", "${file}"],
      "filetypes": ["plaintext"]
    }
  },
  "simpleLspClient.servers": {
    "basedpyright": {
      "cmd": ["basedpyright-langserver", "--stdio"],
      "filetypes": ["python"]
    },
    "clangd": {
      "cmd": ["clangd"],
      "filetypes": ["c", "cpp", "objective-c", "objective-cpp"]
    },
    "ruff": { "cmd": ["ruff", "server"], "filetypes": ["python"] },
    "shls": { "cmd": ["shls.sh"], "filetypes": ["shellscript"] }
  },
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  "terminal.integrated.cwd": "${relativeFileDirname}",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.suggest.enabled": false,
  "terminal.integrated.tabs.enabled": false,
  "update.showReleaseNotes": false,
  "vim.handleKeys": { "<C-b>": false },
  "vim.hlsearch": true,
  "vim.leader": "<space>",
  "vim.normalModeKeyBindingsNonRecursive": [
    { "comment": "normal/visual mode keybindings" },
    {
      "before": ["<leader>"],
      "commands": [
        { "args": ["leaderkeyState", "SPC"], "command": "_setContext" },
        { "args": "SPC", "command": "leaderkey.render" }
      ]
    },
    {
      "before": [","],
      "commands": [
        { "args": ["leaderkeyState", ","], "command": "_setContext" },
        { "args": ",", "command": "leaderkey.render" }
      ]
    },
    { "after": ["g", "j"], "before": ["j"] },
    { "after": ["g", "k"], "before": ["k"] },
    { "after": ["%"], "before": ["%"] },
    { "before": ["<C-o>"], "commands": ["workbench.action.navigateBack"] },
    {
      "before": ["<C-k>"],
      "commands": ["editor.action.addSelectionToNextFindMatch"]
    },
    { "before": ["<C-f>"], "commands": ["actions.find"] },
    { "before": ["<C-p>"], "commands": ["workbench.action.quickOpen"] },
    { "before": ["<C-s>"], "commands": ["workbench.action.files.save"] },
    { "before": ["<C-S-p>"], "commands": ["workbench.action.showCommands"] },
    { "before": ["<C-S-z>"], "commands": ["redo"] },
    { "before": ["<C-z>"], "commands": ["undo"] },
    { "comment": "normal mode keybindings" },
    { "before": ["u"], "commands": ["undo"] },
    { "before": ["<C-r>"], "commands": ["redo"] },
    { "before": ["K"], "commands": ["editor.action.showHover"] },
    {
      "before": ["<C-l>"],
      "commands": ["cSpell.goToPreviousSpellingIssueAndSuggest"]
    },
    { "before": ["<C-S-k>"], "commands": ["editor.action.insertCursorAbove"] },
    { "before": ["<C-S-j>"], "commands": ["editor.action.insertCursorBelow"] }
  ],
  "vim.useSystemClipboard": true,
  "vim.visualModeKeyBindingsNonRecursive": [
    { "comment": "normal/visual mode keybindings" },
    {
      "before": ["<leader>"],
      "commands": [
        { "args": ["leaderkeyState", "SPC"], "command": "_setContext" },
        { "args": "SPC", "command": "leaderkey.render" }
      ]
    },
    {
      "before": [","],
      "commands": [
        { "args": ["leaderkeyState", ","], "command": "_setContext" },
        { "args": ",", "command": "leaderkey.render" }
      ]
    },
    { "after": ["g", "j"], "before": ["j"] },
    { "after": ["g", "k"], "before": ["k"] },
    { "after": ["%"], "before": ["%"] },
    { "before": ["<C-o>"], "commands": ["workbench.action.navigateBack"] },
    {
      "before": ["<C-k>"],
      "commands": ["editor.action.addSelectionToNextFindMatch"]
    },
    { "before": ["<C-f>"], "commands": ["actions.find"] },
    { "before": ["<C-p>"], "commands": ["workbench.action.quickOpen"] },
    { "before": ["<C-s>"], "commands": ["workbench.action.files.save"] },
    { "before": ["<C-S-p>"], "commands": ["workbench.action.showCommands"] },
    { "before": ["<C-S-z>"], "commands": ["redo"] },
    { "before": ["<C-z>"], "commands": ["undo"] },
    { "comment": "visual mode keybindings" },
    { "after": ["p", "g", "v", "y"], "before": ["p"] },
    { "after": [">", "g", "v"], "before": [">"] },
    { "after": ["<", "g", "v"], "before": ["<"] }
  ],
  "window.autoDetectColorScheme": true,
  "window.commandCenter": false,
  "window.menuBarVisibility": "hidden",
  "window.openFoldersInNewWindow": "off",
  "window.titleBarStyle": "native",
  "workbench.activityBar.location": "hidden",
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.editor.showTabs": "none",
  "workbench.editor.useModal": "off",
  "workbench.enableExperiments": false,
  "workbench.experimental.modernUI": false,
  "workbench.layoutControl.enabled": false,
  "workbench.startupEditor": "none",
  "workbench.statusBar.visible": false,
  "workbench.tips.enabled": false,
  "workbench.welcomePage.walkthroughs.openOnInstall": false
}
