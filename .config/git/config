[include]
	path = ~/.config/git/user.config
[core]
	excludesfile = ~/.config/git/gitignore.sorted.txt
[merge]
	conflictstyle = diff3
[include]
	path = ~/.config/git/gitconfig.local
[credential]
	helper = cache --timeout 7200
[advice]
	detachedHead = false
[push]
	autoSetupRemote = true
[diff]
	external = pdiff.rs git
